{
  "name": "@font-previewer/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local typography decision Studio for reviewing, comparing, systemizing, and handing off fonts.",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "build": "npm run check && npm run test && vite build && tsc -p tsconfig.electron.json && vite build --config vite.preload.config.ts",
    "check": "tsc --noEmit",
    "dev": "vite --host 127.0.0.1",
    "electron": "electron .",
    "electron:install": "install-electron",
    "evidence:soak": "npm test && node --expose-gc scripts/run-soak.mjs",
    "package:linux": "npm run build && node scripts/package-linux.mjs",
    "sbom": "node scripts/build-sbom.mjs",
    "test": "node scripts/run-tests.mjs",
    "verify": "npm run build && npm run sbom && npm audit --audit-level=high"
  },
  "dependencies": {
    "fontkit": "2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/fontkit": "2.0.9",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "electron": "44.0.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
